<?php
$flash = $this->flashMessenger();
$notificaciones = [
    'success' => array_merge($flash->getSuccessMessages(), $flash->getCurrentSuccessMessages()),
    'error'   => array_merge($flash->getErrorMessages(), $flash->getCurrentErrorMessages()),
    'alert'   => array_merge($flash->getMessages(), $flash->getCurrentMessages()),
    'information' => array_merge($flash->getInfoMessages(), $flash->getCurrentInfoMessages()),
    'warning' => array_merge($flash->getWarningMessages(), $flash->getCurrentWarningMessages()),
];
$flash->clearCurrentMessages('default');
$flash->clearCurrentMessages('info');
$flash->clearCurrentMessages('success');
$flash->clearCurrentMessages('warning');
$flash->clearCurrentMessages('error');

$mostrarMensajes = '';
foreach (array_filter($notificaciones) as $tipo => $mensajes) {
    $tipoToastr = 'info';
    switch ($tipo) {
        case 'success':
            $tipoToastr = 'success';
            break;
        case 'error':
            $tipoToastr = 'error';
            break;
        case 'alert':
            $tipoToastr = 'warning';
            break;
        case 'warning':
            $tipoToastr = 'warning';
            break;
    }
    foreach ($mensajes as $mensaje) {
        $mostrarMensajes .= "new PNotify({title: 'GestorPortal', text: '$mensaje', type: '$tipoToastr', styling: 'bootstrap3'});";
    }
}

$baseUrl = $this->url('administracion/emisora-excepcion', ['action' => 'index']);
$baseUrl = preg_replace('#/index$#', '', $baseUrl);

$title = 'Excepciones';
$this->headTitle($title);
$this->headLink();
$this->headScript()
    ->prependScript('
        window.baseUrlExcepcion = "' . $baseUrl . '";
        $(document).ajaxStop($.unblockUI);
        $(document).ready(function() {
            $("#myTableExcepciones").DataTable({
                responsive: true, iDisplayLength: 25,
                oLanguage: { sSearch: "Buscar:", sLengthMenu: "Mostrar: _MENU_ registros" },
                aaSorting: [[0, "desc"]]
            });
            $("#modalFormulario").on("hide.bs.modal", function (e) {
                Swal.fire({
                    title: "&iquest;DESEA CERRAR EL FORMULARIO?",
                    icon: "question", showCancelButton: true,
                    confirmButtonText: "Si", cancelButtonText: "No"
                }).then((result) => {
                    if (!result.isConfirmed) $(this).modal("show");
                });
            });
            ' . $mostrarMensajes . '
        });
    ', 'text/javascript', ['noescape' => true])
    ->prependFile($this->basePath('vendors/pnotify/dist/pnotify.nonblock.js'))
    ->prependFile($this->basePath('vendors/pnotify/dist/pnotify.buttons.js'))
    ->prependFile($this->basePath('vendors/pnotify/dist/pnotify.js'))
    ->prependFile($this->basePath('js/sistema/emisora-excepcion.js'))
    ->prependFile($this->basePath('js/jquery.blockUI.js'));
