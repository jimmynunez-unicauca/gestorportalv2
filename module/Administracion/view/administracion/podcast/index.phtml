<?php
// --------- CARGAR MENSAJES DE ALERTA -----------------------------------------
$flash = $this->flashMessenger();
$notificaciones = [
    'success' => array_merge($flash->getSuccessMessages(), $flash->getCurrentSuccessMessages()),
    'error'   => array_merge($flash->getErrorMessages(), $flash->getCurrentErrorMessages()),
    'alert'   => array_merge($flash->getMessages(), $flash->getCurrentMessages()),
    'warning' => array_merge($flash->getWarningMessages(), $flash->getCurrentWarningMessages()),
];
$flash->clearCurrentMessages('default');
$flash->clearCurrentMessages('info');
$flash->clearCurrentMessages('success');
$flash->clearCurrentMessages('warning');
$flash->clearCurrentMessages('error');
$mostrarMensajes = '';
foreach (array_filter($notificaciones) as $tipo => $mensajes) {
    $tipoToastr = ($tipo === 'error') ? 'error' : (($tipo === 'success') ? 'success' : 'warning');
    foreach ($mensajes as $mensaje) {
        $mostrarMensajes .= "new PNotify({title: 'GestorPortal', text: "
            . json_encode($mensaje) . ", type: '$tipoToastr', styling: 'bootstrap3'});";
    }
}

$title = 'Podcasts';
$this->headTitle($title);
$this->headLink();
$this->headScript()
    ->prependScript('
        $(document).ajaxStop($.unblockUI);
        $(document).ready(function() {
            $("#myTablePodcast").DataTable({
                responsive: true,
                iDisplayLength: 25,
                oLanguage: {
                    sLengthMenu: "Mostrar: _MENU_ registros por pagina",
                    sZeroRecords: "NO SE HA ENCONTRADO INFORMACION",
                    sInfo: "Mostrando <b>_START_</b> a <b>_END_</b> registros <br>TOTAL REGISTROS: <b>_TOTAL_</b>",
                    sInfoEmpty: "Mostrando 0 A 0 registros",
                    sInfoFiltered: "(Filtrados de un total de <b>_MAX_</b> registros)",
                    sLoadingRecords: "CARGANDO...",
                    sProcessing: "EN PROCESO...",
                    sSearch: "Buscar:",
                    sEmptyTable: "NO HAY INFORMACION DISPONIBLE PARA LA TABLA",
                    oPaginate: {
                        sFirst: "<i class=\'fa fa-fast-backward\' title=\'Inicio\'></i>",
                        sPrevious: "<i class=\'fa fa-step-backward\' title=\'Anterior\'></i>",
                        sNext: "<i class=\'fa fa-step-forward\' title=\'Siguiente\'></i>",
                        sLast: "<i class=\'fa fa-fast-forward\' title=\'Fin\'></i>"
                    }
                },
                aaSorting: [[0, "desc"]]
            });

            $("#modalFormulario").on("hide.bs.modal", function () {
                Swal.fire({
                    title: "¿DESEA CERRAR EL FORMULARIO?",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonText: "Si",
                    cancelButtonText: "No",
                    allowOutsideClick: false
                }).then(function (result) {
                    if (!result.isConfirmed) $("#modalFormulario").modal("show");
                });
            });

            ' . $mostrarMensajes . '
        });
    ', 'text/javascript', ['noescape' => true])
    ->prependFile($this->basePath('js/sistema/podcast.js'));
