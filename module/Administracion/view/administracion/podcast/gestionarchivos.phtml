<?php
$flash = $this->flashMessenger();
$notificaciones = [
    'success' => array_merge($flash->getSuccessMessages(), $flash->getCurrentSuccessMessages()),
    'error'   => array_merge($flash->getErrorMessages(), $flash->getCurrentErrorMessages()),
];
$flash->clearCurrentMessages('success');
$flash->clearCurrentMessages('error');
$mostrarMensajes = '';
foreach (array_filter($notificaciones) as $tipo => $mensajes) {
    $tipoToastr = ($tipo === 'error') ? 'error' : 'success';
    foreach ($mensajes as $mensaje) {
        $mostrarMensajes .= "new PNotify({title: 'GestorPortal', text: " . json_encode($mensaje) . ", type: '$tipoToastr', styling: 'bootstrap3'});";
    }
}

$title = 'Gestión de Almacenamiento';
$this->headTitle($title);
$this->headScript()
    ->prependScript('
        $(document).ajaxStop($.unblockUI);
        $(document).ready(function() {
            $("#tablaArchivos").DataTable({
                responsive: true,
                iDisplayLength: 25,
                order: [[4, "desc"]], // Ordenar por peso por defecto
                oLanguage: { sSearch: "Buscar:", sLengthMenu: "Mostrar: _MENU_", sInfo: "Mostrando _START_ a _END_ de _TOTAL_" }
            });
            ' . $mostrarMensajes . '
        });
    ', 'text/javascript', ['noescape' => true]);
?>

